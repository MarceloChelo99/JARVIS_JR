# Pick one based on the provider in configs/default.yaml.

# Anthropic Claude — paid, best quality
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini — free tier available, default
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Ollama runs locally; no API key needed.

# LM Studio: if the server requires an API token (Developer tab -> Settings),
# put it here. Leave empty for Ollama or token-less LM Studio.
LOCAL_LLM_API_KEY=

# Evals: read-only Gmail tools (scripts/run_evals.py evals/tasks_gmail).
# App password from myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Trading research feeds (scripts/run_trading_episode.py). Both optional —
# a scenario that asks for them runs with fewer tools if they're unset.
# FRED macro data, point-in-time via ALFRED vintages. Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# SecFiler's data directory (10-K/10-Q summaries + analysis features).
SECFILER_DATA_DIR=/Users/marcelocastellanos/PycharmProjects/SecFiler/data
# Tiingo daily bars for the research playbook (scripts/research_fetch.py).
# Free key: https://www.tiingo.com (Sign-up -> API token)
TIINGO_API_KEY=
